HOST=0.0.0.0
PORT=6060
LOG_LEVEL=INFO
SUPERUSERS=["<your_qq_uin>"]
NICKNAME=[]
COMMAND_START=["/", ""]
COMMAND_SEP=["."]
QQ_ACCOUNT=<bot_qq_uin>

# 每日问候要发送的群号列表（daily-greeting 插件）
GREETING_TARGETS=["<group_id>"]

# 群消息同步插件：要监听的源群列表，在任意群 /sync 触发同步到当前群
FORWARD_SOURCE_GROUPS=["<group_id>"]
# 定时同步目标群列表：每天 09:00 自动同步到这些群
SYNC_TARGET_GROUPS=["<group_id>"]

# 每日问候调试开关
# apscheduler 日志级别（10=DEBUG 20=INFO 30=WARNING）
APSCHEDULER_LOG_LEVEL=30
# 测试任务触发时间 HH:MM:SS，留空不注册；每次测试时修改
GREETING_TEST_TIME=""

# 工具（只读）配置
# 允许工具访问的目录，逗号分隔；bot 的"电脑"= 挂载进容器的家目录 /home/host
TOOL_ALLOW_DIRS=/home/host,/app/data
# 禁止访问的路径片段（含敏感文件），逗号分隔；命中则拒绝
TOOL_DENY=.ssh,.aws,keychains,.config,.env,id_rsa,.pem,credentials,token,secret,keychain
# 单次工具输出最大字符数
TOOL_MAX_OUT=3000